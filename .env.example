POSTGRES_DB=tarot_engine
POSTGRES_USER=tarot
POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgresql+psycopg://tarot:change-this-password@db:5432/tarot_engine
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://ganna40.github.io
AUTO_SEED_CURATED=true

# 선택 사항: 공개 배포 시 설정. 정적 검증 화면에서 Bearer 또는 X-API-Key로 전달합니다.
API_ACCESS_KEY=

# 문장화 Provider: openai_api | codex_subscription
# codex_subscription은 로컬 호스트에서 `codex login`한 Codex CLI를 사용합니다.
LLM_PROVIDER=openai_api

# OpenAI API provider. 비워두면 API provider 호출 실패 시 규칙 기반 문장으로 fallback합니다.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=30

# Local Codex subscription provider.
CODEX_EXECUTABLE=codex
CODEX_MODEL=
CODEX_TIMEOUT_SECONDS=120
